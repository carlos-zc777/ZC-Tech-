// api/shorten.js
export default async function handler(req, res) {
  const { link } = req.query;

  // Leemos el token desde la variable de entorno de Netlify
  const apiToken = process.env.MI_ACORTADOR_TOKEN; 

  if (!link) {
    return res.status(400).json({ error: "Falta el parámetro link" });
  }

  // Verificamos si el token se cargó correctamente
  if (!apiToken) {
    console.error("El API Token (MI_ACORTADOR_TOKEN) no está configurado.");
    return res.status(500).json({ error: "Error de configuración del servidor." });
  }

  try {
    // TODO: Reemplaza esta URL con la del API de tu nuevo acortador.
    // Asegúrate de ajustar los parámetros según la documentación de tu servicio.
    const response = await fetch(
      `https://api.nuevo-servicio.com/v1/shorten?apiKey=${apiToken}&url=${encodeURIComponent(link)}`
    );

    // TODO: Ajusta esto según cómo responda tu nuevo API (texto o JSON)
    const shortUrl = await response.text();
    
    // Si fuera JSON, usarías algo como:
    // const data = await response.json();
    // const shortUrl = data.shortUrl; 

    res.status(200).json({
      short: shortUrl.trim(),
      original: link
    });
  } catch (err) {
    console.error("Error al contactar el API del acortador:", err);
    res.status(500).json({ error: "Error al acortar enlace" });
  }
}
